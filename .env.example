# =============================================================================
# Hybrid RAG — Environment Configuration
# Copy to .env and fill in your values.
# =============================================================================

# --- API keys ---
GROQ_API_KEY=

# Optional: protect admin/query endpoints (you create these — see README § API Keys)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_API_KEY=
QUERY_API_KEY=

# --- LLM (Groq) ---
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0

# --- Embeddings (Ollama) ---
EMBEDDING_MODEL=snowflake-arctic-embed:137m
OLLAMA_BASE_URL=http://localhost:11434

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# --- Gunicorn (production / Docker) ---
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=2
GUNICORN_THREADS=1
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_WORKER_CLASS=uvicorn.workers.UvicornWorker
GUNICORN_LOG_LEVEL=info
GUNICORN_ACCESS_LOG=-
GUNICORN_ERROR_LOG=-
GUNICORN_PRELOAD=false
GUNICORN_CAPTURE_OUTPUT=true

# Docker: point to host Ollama
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Logging ---
LOG_NAME=hybrid_rag
LOG_LEVEL=INFO
LOG_FILE=logs/hybrid_rag.log
LOG_TO_CONSOLE=true

# --- Qdrant (dense + sparse vectors) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=employment_contracts
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_SPARSE_VECTOR_NAME=sparse
QDRANT_UPSERT_BATCH_SIZE=32

# --- Redis (semantic cache, ingest jobs, rate-limit store, DLQ) ---
REDIS_URL=redis://localhost:6379/0

# --- Paths ---
DATA_DIR=./data
STORAGE_DIR=./storage

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- Retrieval (k = number of chunks returned) ---
DENSE_K=10
SPARSE_K=10
HYBRID_K=10
NAIVE_K=5

# --- Reranker (small / fast default) ---
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_N=5

# --- Sparse / keyword vectors (Qdrant BM25 via FastEmbed) ---
SPARSE_MODEL=Qdrant/bm25

# --- Company pre-filter keywords (comma-separated) ---
COMPANY_KEYWORDS=honeywell,cloudflare

# --- Semantic cache ---
CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_TTL_SECONDS=86400

# --- Rate limiting ---
RATE_LIMIT=10/minute

# --- Reliability ---
DLQ_MAX_RETRIES=3
INGEST_JOB_TTL_SECONDS=86400

# --- Evaluation ---
EVAL_CONCURRENCY=5
EVAL_OUTPUT_PATH=./evaluation_results.md
